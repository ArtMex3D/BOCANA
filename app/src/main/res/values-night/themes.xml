<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Bocana" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/bocana_neon_purple</item>
        <item name="colorSecondary">@color/bocana_neon_cyan</item>
        <item name="colorTertiary">@color/bocana_neon_green</item>
        <item name="colorSurface">@color/bocana_surface</item>
        <item name="colorOnSurface">@color/bocana_text_primary</item>
        <item name="android:colorBackground">@color/bocana_screen_background</item>
        <item name="android:windowBackground">@color/bocana_screen_background</item>
        <item name="android:statusBarColor">@color/bocana_screen_background</item>
        <item name="android:navigationBarColor">@color/bocana_screen_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <style name="Theme.Bocana.SplashScreen" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:statusBarColor">@color/bocana_screen_background</item>
        <item name="android:navigationBarColor">@color/bocana_screen_background</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>
</resources>

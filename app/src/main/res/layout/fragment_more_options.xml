<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        tools:context=".ui.masopciones.MoreOptionsFragment">

        <!-- ========================================== -->
        <!-- BANNER DE ACTUALIZACIÓN (DISEÑO PREMIUM)   -->
        <!-- ========================================== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_update_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:visibility="gone"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorPrimaryVariant"
            app:strokeWidth="1dp"
            tools:visibility="visible">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/colorSurfaceVariant"
                android:padding="20dp">

                <ImageView
                    android:id="@+id/icon_update"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@android:drawable/stat_sys_download"
                    app:tint="?attr/colorPrimary"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv_update_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Nueva versión lista"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toEndOf="@id/icon_update"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/icon_update"
                    app:layout_constraintBottom_toTopOf="@id/tv_update_version" />

                <TextView
                    android:id="@+id/tv_update_version"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    tools:text="Versión 2.0"
                    android:textSize="14sp"
                    android:textColor="?android:attr/textColorSecondary"
                    app:layout_constraintStart_toStartOf="@id/tv_update_title"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_update_title" />

                <TextView
                    android:id="@+id/tv_update_notes"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    tools:text="- Mejoras de rendimiento\n- Corrección de bugs"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/icon_update" />

                <ProgressBar
                    android:id="@+id/progress_bar_download"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:visibility="gone"
                    tools:progress="50"
                    tools:visibility="visible"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_update_notes" />

                <TextView
                    android:id="@+id/tv_download_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    tools:text="50%"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:visibility="visible"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/progress_bar_download" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_download_update"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="16dp"
                    android:text="Descargar Actualización"
                    android:textSize="16sp"
                    app:cornerRadius="16dp"
                    app:layout_constraintTop_toBottomOf="@id/tv_download_status"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ========================================== -->
        <!-- SECCIÓN DE BOTONES NORMALES                -->
        <!-- ========================================== -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_advanced_history"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Búsqueda Avanzada"
            app:icon="@android:drawable/ic_menu_search"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonNavToAjustes"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/pending_item_background"
            android:text="Ajuste Manual de Lote"
            app:icon="@drawable/ic_settings" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonNavToReportGenerator"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Generar Reporte PDF"
            app:icon="@drawable/pdf"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonNavToArchivedProducts"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/pending_item_background"
            android:text="Productos Archivados"
            app:icon="@drawable/guardar" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonNavToDevoluciones"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Devoluciones Pendientes"
            app:icon="@drawable/devolucion"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_history"
            android:visibility="gone"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/pending_item_background"
            android:text="Historial de Movimientos"
            app:icon="@drawable/historial"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonNavToConfigTraspasos"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/pending_item_background"
            android:text="Configuración de Traspasos"
            app:icon="@drawable/ic_settings" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonNavToProveedores"
            android:visibility="gone"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/pending_item_background"
            android:text="Gestionar Proveedores"
            app:icon="@drawable/ic_manage_users"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonNavToLotMigration"
            android:visibility="gone"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Convertir Lotes Antiguos"
            app:icon="@drawable/ic_exchange"
            app:strokeColor="@android:color/holo_orange_dark"
            android:textColor="@android:color/holo_orange_dark"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_migrate_data"
            android:visibility="gone"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:strokeColor="@android:color/holo_red_dark"
            android:textColor="@android:color/holo_red_dark"
            android:text="Mantenimiento de Datos v3.0"
            app:icon="@android:drawable/ic_dialog_alert"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_force_sync"
            android:visibility="gone"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:strokeColor="@android:color/holo_orange_dark"
            android:textColor="@android:color/holo_orange_dark"
            android:text="Sincronización Forzada"
            app:icon="@android:drawable/stat_notify_sync"/>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
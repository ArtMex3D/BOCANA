<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F2FF"
    android:fillViewport="true"
    tools:context=".ui.masopciones.MoreOptionsFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ══════════════════════════════════════
             HEADER
             ══════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/Letras"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="#33FFFFFF"
                android:gravity="center"
                android:text="⚙️"
                android:textSize="22sp"
                android:includeFontPadding="false" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HERRAMIENTAS"
                    android:textColor="#80FFFFFF"
                    android:textSize="10sp"
                    android:letterSpacing="0.15"
                    android:textAllCaps="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Más Opciones"
                    android:textColor="@android:color/white"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Franja accent magenta -->
        <View
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:background="@color/brand_purple" />

        <!-- ══════════════════════════════════════
             CONTENIDO
             ══════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="20dp">

            <!-- ── BANNER DE ACTUALIZACIÓN ── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_update_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/brand_purple"
                app:strokeWidth="2dp"
                app:cardBackgroundColor="#FFF0F7"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Fila icono + títulos -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/icon_update"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="#1AE8005E"
                            android:padding="8dp"
                            android:src="@android:drawable/stat_sys_download"
                            app:tint="@color/brand_purple" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">

                            <TextView
                                android:id="@+id/tv_update_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Nueva versión lista"
                                android:textColor="@color/Letras"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_update_version"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/brand_purple"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                tools:text="Versión 2.0" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Notas de actualización -->
                    <TextView
                        android:id="@+id/tv_update_notes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textColor="@color/Letras"
                        android:textSize="13sp"
                        android:lineSpacingExtra="4dp"
                        tools:text="- Mejoras de rendimiento&#10;- Corrección de bugs" />

                    <!-- Progress bar -->
                    <ProgressBar
                        android:id="@+id/progress_bar_download"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:visibility="gone"
                        tools:progress="50"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/tv_download_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_gravity="end"
                        android:textColor="@color/brand_purple"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:text="50%"
                        tools:visibility="visible" />

                    <!-- Botón descarga -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_download_update"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="12dp"
                        android:text="Descargar Actualización"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/brand_purple"
                        app:cornerRadius="10dp"
                        app:icon="@android:drawable/stat_sys_download"
                        app:iconTint="@android:color/white"
                        app:iconSize="16dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ── SECCIÓN: GESTIÓN ── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="GESTIÓN"
                android:textColor="@color/brand_purple"
                android:textSize="10sp"
                android:letterSpacing="0.12"
                android:textAllCaps="true"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@android:color/white"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <!-- Búsqueda Avanzada -->
                    <LinearLayout
                        android:id="@+id/button_advanced_history"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="#1A020961"
                            android:gravity="center"
                            android:text="🔍"
                            android:textSize="15sp"
                            android:includeFontPadding="false" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:text="Búsqueda Avanzada"
                            android:textColor="@color/Letras"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textColor="#BBBBBB"
                            android:textSize="20sp" />

                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="#F0F0F0" android:layout_marginStart="62dp" />

                    <!-- Ajuste Manual de Lote -->
                    <LinearLayout
                        android:id="@+id/buttonNavToAjustes"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="#1AE8005E"
                            android:gravity="center"
                            android:text="🔧"
                            android:textSize="15sp"
                            android:includeFontPadding="false" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:text="Ajuste Manual de Lote"
                            android:textColor="@color/Letras"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textColor="#BBBBBB"
                            android:textSize="20sp" />

                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="#F0F0F0" android:layout_marginStart="62dp" />

                    <!-- Generar Reporte PDF -->
                    <LinearLayout
                        android:id="@+id/buttonNavToReportGenerator"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="#1A020961"
                            android:gravity="center"
                            android:text="📄"
                            android:textSize="15sp"
                            android:includeFontPadding="false" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:text="Generar Reporte PDF"
                            android:textColor="@color/Letras"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textColor="#BBBBBB"
                            android:textSize="20sp" />

                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="#F0F0F0" android:layout_marginStart="62dp" />

                    <!-- Productos Archivados -->
                    <LinearLayout
                        android:id="@+id/buttonNavToArchivedProducts"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="#1AE8005E"
                            android:gravity="center"
                            android:text="📦"
                            android:textSize="15sp"
                            android:includeFontPadding="false" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:text="Productos Archivados"
                            android:textColor="@color/Letras"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textColor="#BBBBBB"
                            android:textSize="20sp" />

                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="#F0F0F0" android:layout_marginStart="62dp" />

                    <!-- Devoluciones Pendientes -->
                    <LinearLayout
                        android:id="@+id/buttonNavToDevoluciones"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="#1A020961"
                            android:gravity="center"
                            android:text="↩️"
                            android:textSize="15sp"
                            android:includeFontPadding="false" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:text="Devoluciones Pendientes"
                            android:textColor="@color/Letras"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textColor="#BBBBBB"
                            android:textSize="20sp" />

                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="#F0F0F0" android:layout_marginStart="62dp" />

                    <!-- Configuración de Traspasos -->
                    <LinearLayout
                        android:id="@+id/buttonNavToConfigTraspasos"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="#1AE8005E"
                            android:gravity="center"
                            android:text="⚙️"
                            android:textSize="15sp"
                            android:includeFontPadding="false" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:text="Configuración de Traspasos"
                            android:textColor="@color/Letras"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textColor="#BBBBBB"
                            android:textSize="20sp" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ── ITEMS OCULTOS (visibility=gone, respetados) ── -->
            <LinearLayout
                android:id="@+id/button_history"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:visibility="gone"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="#1A020961"
                    android:gravity="center"
                    android:text="📋"
                    android:textSize="15sp"
                    android:includeFontPadding="false" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:text="Historial de Movimientos"
                    android:textColor="@color/Letras"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#BBBBBB"
                    android:textSize="20sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/buttonNavToProveedores"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:visibility="gone"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="#1AE8005E"
                    android:gravity="center"
                    android:text="👥"
                    android:textSize="15sp"
                    android:includeFontPadding="false" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:text="Gestionar Proveedores"
                    android:textColor="@color/Letras"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#BBBBBB"
                    android:textSize="20sp" />

            </LinearLayout>

            <!-- ── SECCIÓN: MANTENIMIENTO (peligrosa) ── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MANTENIMIENTO"
                android:textColor="#CC6600"
                android:textSize="10sp"
                android:letterSpacing="0.12"
                android:textAllCaps="true"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"
                android:visibility="gone"
                tools:visibility="visible" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                tools:visibility="visible"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@android:color/white"
                app:strokeColor="#FFCC80"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <!-- Convertir Lotes Antiguos -->
                    <LinearLayout
                        android:id="@+id/buttonNavToLotMigration"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:visibility="gone"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="#1AFFAA00"
                            android:gravity="center"
                            android:text="🔁"
                            android:textSize="15sp"
                            android:includeFontPadding="false" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:text="Convertir Lotes Antiguos"
                            android:textColor="@android:color/holo_orange_dark"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textColor="#BBBBBB"
                            android:textSize="20sp" />

                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="#F0F0F0" android:layout_marginStart="62dp" />

                    <!-- Mantenimiento de Datos -->
                    <!-- Generar Checkpoints de Consumo -->
                    <LinearLayout
                        android:id="@+id/button_generate_checkpoints"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:visibility="gone"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="#1A00D90E"
                            android:gravity="center"
                            android:text="📊"
                            android:textSize="15sp"
                            android:includeFontPadding="false" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:text="Generar Historial de Consumo"
                            android:textColor="#008000"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textColor="#BBBBBB"
                            android:textSize="20sp" />

                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="#F0F0F0" android:layout_marginStart="62dp" />

                    <LinearLayout
                        android:id="@+id/button_migrate_data"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:visibility="gone"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="#1AFF0000"
                            android:gravity="center"
                            android:text="⚠️"
                            android:textSize="15sp"
                            android:includeFontPadding="false" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:text="Mantenimiento de Datos v3.0"
                            android:textColor="@android:color/holo_red_dark"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textColor="#BBBBBB"
                            android:textSize="20sp" />

                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="#F0F0F0" android:layout_marginStart="62dp" />

                    <!-- Sincronización Forzada -->
                    <LinearLayout
                        android:id="@+id/button_force_sync"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:visibility="gone"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="#1AFFAA00"
                            android:gravity="center"
                            android:text="🔄"
                            android:textSize="15sp"
                            android:includeFontPadding="false" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:text="Sincronización Forzada"
                            android:textColor="@android:color/holo_orange_dark"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/text_view_dialog_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceHeadline6"
            tools:text="Convertir Lote de Tilapia" />

        <TextView
            android:id="@+id/text_view_stock_actual"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="?attr/textAppearanceBody2"
            tools:text="Stock Registrado: 200.00 Kg" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Método de Conversión:"
            android:textAppearance="?attr/textAppearanceBody2" />

        <RadioGroup
            android:id="@+id/radioGroupCalculationType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/radioButtonVariable"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Variable (Solo Kg)" />

            <RadioButton
                android:id="@+id/radioButtonRedondeo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Redondear a Peso Fijo" />

            <RadioButton
                android:id="@+id/radioButtonPromedio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Promediar por Unidades" />
        </RadioGroup>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/text_input_layout_unidad_empaque"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Tipo de Empaque (ej. Costal, Caja)">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_text_unidad_empaque"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/textFieldLayoutPesoFijo"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Peso Fijo por Unidad (Kg)"
            android:visibility="gone"
            tools:visibility="visible">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextPesoFijo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/textFieldLayoutCantidadUnidades"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Cantidad Total de Unidades">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextCantidadUnidades"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/text_view_calculado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:layout_marginTop="4dp"
            android:textAppearance="?attr/textAppearanceBody2"
            android:textColor="?attr/colorPrimary"
            android:visibility="gone"
            tools:visibility="visible"
            tools:text="= 19 Cajas de 30.00 Kg y 1 Caja de 27.00 Kg" />

    </LinearLayout>
</ScrollView>


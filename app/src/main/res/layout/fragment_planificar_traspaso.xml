<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.traspasos.plan.PlanificarTraspasoFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Barra operativa compacta:
             [ FECHA ] [ ACTUALIZAR ] [ + FILA ] [ GENERAR PDF ] -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="7dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="5dp"
            app:cardBackgroundColor="#FBFBFE"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:strokeColor="#DDE1F2"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="7dp"
                android:paddingTop="6dp"
                android:paddingEnd="7dp"
                android:paddingBottom="6dp">

                <!-- Fecha: lavanda suave, visible pero no dominante -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_traspaso_date"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1.05"
                    android:layout_marginEnd="5dp"
                    android:elevation="2dp"
                    android:minWidth="0dp"
                    android:minHeight="40dp"
                    android:textAllCaps="false"
                    android:textColor="#26338C"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    app:backgroundTint="#F0F2FF"
                    app:cornerRadius="11dp"
                    app:icon="@android:drawable/ic_menu_my_calendar"
                    app:iconGravity="textStart"
                    app:iconPadding="4dp"
                    app:iconSize="16dp"
                    app:iconTint="#3949AB"
                    app:rippleColor="#243949AB"
                    app:strokeColor="#AEB8E8"
                    app:strokeWidth="1dp"
                    tools:text="JUE 18/09" />

                <!-- Actualizar: acción rápida y positiva -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_regenerar_sugerencias"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="5dp"
                    android:contentDescription="Actualizar sugerencias"
                    android:elevation="3dp"
                    android:minWidth="0dp"
                    android:minHeight="40dp"
                    android:padding="0dp"
                    android:text=""
                    app:backgroundTint="#2E7D32"
                    app:cornerRadius="11dp"
                    app:icon="@android:drawable/ic_popup_sync"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="21dp"
                    app:iconTint="#FFFFFF"
                    app:rippleColor="#33FFFFFF"
                    app:strokeColor="#1B5E20"
                    app:strokeWidth="1dp" />

                <!-- Fila: ámbar, distingue una acción auxiliar de captura -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_agregar_fila_vacia"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="78dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="5dp"
                    android:elevation="2dp"
                    android:minWidth="0dp"
                    android:minHeight="40dp"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"
                    android:text="Fila"
                    android:textAllCaps="false"
                    android:textColor="#8A4B00"
                    android:textSize="10.8sp"
                    android:textStyle="bold"
                    app:backgroundTint="#FFF1DB"
                    app:cornerRadius="11dp"
                    app:icon="@android:drawable/ic_input_add"
                    app:iconGravity="textStart"
                    app:iconPadding="2dp"
                    app:iconSize="15dp"
                    app:iconTint="#B66300"
                    app:rippleColor="#26B66300"
                    app:strokeColor="#F0B45C"
                    app:strokeWidth="1dp" />

                <!-- PDF: acción principal -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_generar_pdf_top"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1.35"
                    android:elevation="4dp"
                    android:minWidth="0dp"
                    android:minHeight="40dp"
                    android:text="Generar PDF"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/Letras"
                    app:cornerRadius="11dp"
                    app:icon="@drawable/pdf"
                    app:iconPadding="5dp"
                    app:iconSize="18dp"
                    app:iconTint="@android:color/white"
                    app:rippleColor="#33FFFFFF"
                    app:strokeColor="#01054C"
                    app:strokeWidth="1dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view_plan_traspaso"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="12dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_plan_traspaso" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress_bar_plan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        tools:visibility="visible" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>

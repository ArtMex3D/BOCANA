<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/packagingCardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="14dp"
    android:layout_marginTop="6dp"
    android:layout_marginEnd="14dp"
    android:layout_marginBottom="6dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="1dp"
    app:strokeColor="#D9DDE8"
    app:strokeWidth="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textViewPackProductName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#111B52"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="H.M." />

            <TextView
                android:id="@+id/textViewPackTimeElapsed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#DCEBFF"
                android:paddingStart="10dp"
                android:paddingTop="5dp"
                android:paddingEnd="10dp"
                android:paddingBottom="5dp"
                android:textColor="#315F9F"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Pendiente 2 días" />
        </LinearLayout>

        <TextView
            android:id="@+id/textViewPackQuantityValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#17171C"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="550 Kg pendientes" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textViewPackSupplier"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#4F4F59"
                android:textSize="13sp"
                tools:text="MobyDick" />

            <TextView
                android:id="@+id/textViewPackDateValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textColor="#4F4F59"
                android:textSize="13sp"
                tools:text="Llegó 19/09/26" />
        </LinearLayout>

        <TextView
            android:id="@+id/textViewPackInsight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="#315F9F"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="Conviene prepararlo para próximos traspasos" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:background="#22000000" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonLabels"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Etiquetas"
                android:textAllCaps="false"
                android:textColor="#6A4FA3"
                android:textStyle="bold"
                app:cornerRadius="13dp"
                app:strokeColor="#6A4FA3"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonMarkPackaged"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Empacar"
                android:textAllCaps="false"
                android:textStyle="bold"
                app:backgroundTint="#0B6E4F"
                app:cornerRadius="13dp" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

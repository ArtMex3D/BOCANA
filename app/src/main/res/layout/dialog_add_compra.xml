<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ══════════════════════════════════════
             HEADER con banda de color brand
             ══════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/Letras"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Ícono de caja/compra -->
            <TextView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="#33FFFFFF"
                android:gravity="center"
                android:text="🛒"
                android:textSize="18sp"
                android:includeFontPadding="false" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NUEVA COMPRA"
                    android:textColor="#80FFFFFF"
                    android:textSize="10sp"
                    android:letterSpacing="0.15"
                    android:textAllCaps="true" />

                <TextView
                    android:id="@+id/textViewDialogTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp"
                    tools:text="Atún Aleta Amarilla" />

            </LinearLayout>

        </LinearLayout>

        <!-- Franja accent magenta delgada -->
        <View
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:background="@color/brand_purple" />

        <!-- ══════════════════════════════════════
             CUERPO DEL FORMULARIO
             ══════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="10dp"
            android:paddingBottom="8dp">

            <!-- ── Sección: Tipo de recepción ── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TIPO DE RECEPCIÓN"
                android:textColor="@color/brand_purple"
                android:textSize="10sp"
                android:letterSpacing="0.12"
                android:textAllCaps="true"
                android:textStyle="bold"
                android:paddingStart="20dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1AE8005E"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="10dp" />

            <!-- Card para los radio buttons -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:strokeColor="#E0E0E0"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="#F8F9FF">

                <RadioGroup
                    android:id="@+id/radioGroupReceptionType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <RadioButton
                        android:id="@+id/radioButtonRecepcionUnidades"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:gravity="center_vertical"
                        android:paddingStart="8dp"
                        android:text="📦  Por Unidades (Peso Fijo)"
                        android:textColor="@color/Letras"
                        android:textSize="14sp"
                        android:buttonTint="@color/brand_purple" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E0E0E0"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp" />

                    <RadioButton
                        android:id="@+id/radioButtonRecepcionGranel"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:gravity="center_vertical"
                        android:paddingStart="8dp"
                        android:text="⚖️  A Granel (Peso Neto)"
                        android:textColor="@color/Letras"
                        android:textSize="14sp"
                        android:buttonTint="@color/brand_purple" />

                </RadioGroup>

            </com.google.android.material.card.MaterialCardView>

            <!-- ── Sección dinámica: Por Unidades ── -->
            <LinearLayout
                android:id="@+id/layoutRecepcionUnidades"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginTop="16dp"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/textFieldLayoutUnidadEmpaque"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:hint="Tipo de Empaque"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:boxStrokeColor="@color/Letras"
                        app:hintTextColor="@color/Letras">

                        <AutoCompleteTextView
                            android:id="@+id/autoCompleteUnidadEmpaque"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:textColor="@color/Letras" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/textFieldLayoutPesoPorUnidad"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Peso x Unidad (Kg)"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:boxStrokeColor="@color/Letras"
                        app:hintTextColor="@color/Letras">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editTextPesoPorUnidad"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal"
                            android:textColor="@color/Letras" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/textFieldLayoutCantidadUnidades"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="Cantidad de Unidades"
                    app:boxCornerRadiusBottomEnd="10dp"
                    app:boxCornerRadiusBottomStart="10dp"
                    app:boxCornerRadiusTopEnd="10dp"
                    app:boxCornerRadiusTopStart="10dp"
                    app:boxStrokeColor="@color/Letras"
                    app:hintTextColor="@color/Letras">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editTextCantidadUnidades"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:textColor="@color/Letras" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <!-- ── Campo: Cantidad Granel ── -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textFieldLayoutCantidadGranel"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Cantidad NETA (Kg)"
                android:visibility="gone"
                app:boxCornerRadiusBottomEnd="10dp"
                app:boxCornerRadiusBottomStart="10dp"
                app:boxCornerRadiusTopEnd="10dp"
                app:boxCornerRadiusTopStart="10dp"
                app:boxStrokeColor="@color/Letras"
                app:hintTextColor="@color/Letras"
                tools:visibility="visible">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editTextCantidadGranel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:textColor="@color/Letras" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Info peso neto calculado -->
            <TextView
                android:id="@+id/textViewPesoNetoInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/positive_green"
                android:visibility="gone"
                tools:visibility="visible"
                tools:text="= 90.80 Kg Neto" />

            <!-- ── Separador ── -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#F0F0F0"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp" />

            <!-- ── Sección: Detalles ── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DETALLES DE ENTRADA"
                android:textColor="@color/brand_purple"
                android:textSize="10sp"
                android:letterSpacing="0.12"
                android:textAllCaps="true"
                android:textStyle="bold"
                android:paddingStart="20dp"
                android:layout_marginBottom="10dp" />

            <!-- Proveedor -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textFieldLayoutProveedor"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Proveedor (Recomendado)"
                app:boxCornerRadiusBottomEnd="10dp"
                app:boxCornerRadiusBottomStart="10dp"
                app:boxCornerRadiusTopEnd="10dp"
                app:boxCornerRadiusTopStart="10dp"
                app:boxStrokeColor="@color/Letras"
                app:hintTextColor="@color/Letras"
                app:startIconDrawable="@android:drawable/ic_menu_myplaces"
                app:startIconTint="@color/Letras">

                <AutoCompleteTextView
                    android:id="@+id/autoCompleteProveedor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords"
                    android:textColor="@color/Letras" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Fecha -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonSelectDate"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="Seleccionar Fecha de Recepción"
                android:textColor="@color/Letras"
                android:textSize="14sp"
                app:cornerRadius="10dp"
                app:icon="@android:drawable/ic_menu_today"
                app:iconTint="@color/Letras"
                app:strokeColor="@color/Letras"
                app:strokeWidth="1dp" />

        </LinearLayout>

        <!-- ══════════════════════════════════════
             FOOTER con botones
             ══════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#F8F9FF"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="14dp"
            android:paddingBottom="16dp"
            android:gravity="end">

            <!-- Franja arriba del footer -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonDialogCancelar"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:text="Cancelar"
                android:textColor="#999999"
                android:textSize="14sp"
                app:cornerRadius="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonDialogAceptar"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="Comprar"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@color/Letras"
                app:cornerRadius="10dp"
                app:icon="@android:drawable/ic_menu_save"
                app:iconTint="@android:color/white"
                app:iconSize="16dp"
                app:iconPadding="6dp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
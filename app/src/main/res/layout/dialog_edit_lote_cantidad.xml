<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/textView_lote_info_edit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Editando Lote:"
        android:textAppearance="?attr/textAppearanceTitleMedium" />

    <TextView
        android:id="@+id/textView_stock_disponible_edit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="Disponible: 0 Cajas"
        android:textAppearance="?attr/textAppearanceBodyMedium" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/textField_layout_cantidad_edit"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:suffixText="Unidades">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editText_cantidad_lote_edit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Cantidad a tomar"
            android:inputType="numberDecimal"
            android:selectAllOnFocus="true" />

    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>

